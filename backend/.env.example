# Variables específicas de cada entorno; copiar a .env.development o .env.production.
# Compose carga .env.development. Fuera de Compose, exportarlas antes de arrancar.
# Las políticas comunes (caducidades, cuotas y ajustes internos) están en application.properties.

# PostgreSQL (Neon): URL JDBC, usuario y contraseña de la rama correspondiente
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Object Storage (Neon): endpoint, región y bucket del entorno
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# JWT: emisor del entorno y clave Base64 de al menos 32 bytes aleatorios
JWT_ISSUER=
JWT_SECRET=

# CORS: orígenes completos permitidos, separados por comas
CORS_ALLOWED_ORIGINS=

# Mail: servidor SMTP y remitente del entorno
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_STARTTLS=
MAIL_FROM=

# Verificación de email: clave Base64 independiente de al menos 32 bytes aleatorios
EMAIL_VERIFICATION_SECRET=

# Invitaciones de creación de cuentas: otra clave Base64 independiente de al menos 32 bytes
STAFF_INVITATION_SECRET=
