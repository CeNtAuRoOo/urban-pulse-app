        <mxCell id="n10" parent="1" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#eef4ff;strokeColor=#537fb4;strokeWidth=1.6;shadow=0;overflow=fill;" value="&lt;div style=&quot;font-family:Arial;&quot;&gt;&lt;div style=&quot;background:#537fb4;color:white;font-size:15px;font-weight:bold;padding:9px 10px;&quot;&gt;Notification&lt;span style=&quot;font-size:10px;font-weight:normal;&quot;&gt; · table&lt;/span&gt;&lt;/div&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 10px;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;font-size:12px;color:#a55c27;font-weight:bold;&quot;&gt;&lt;br&gt;id&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:1px 8px;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#67788b;&quot;&gt;&lt;br&gt;PK&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 10px;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;font-size:12px;color:#397b88;font-weight:bold;&quot;&gt;recipient_user_id&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:1px 8px;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#67788b;&quot;&gt;FK&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 10px;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;font-size:12px;color:#397b88;font-weight:bold;&quot;&gt;incident_id&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:1px 8px;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:10px;color:#67788b;&quot;&gt;FK?&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 10px;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family:Consolas,monospace;font-size:12px;color:#334452;font-weight:normal;&quot;&gt;type&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:1px 8px;text-align:right;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&