); font-weight: bold;&quot;&gt;linked_by_user_id&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:1px 8px;text-align:right;&quot;&gt;&lt;span style=&quot;font-size: 10px; color: rgb(103, 120, 139);&quot;&gt;FK&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 10px;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family: Consolas, monospace; font-size: 12px; color: rgb(51, 68, 82); font-weight: normal;&quot;&gt;reason&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:1px 8px;text-align:right;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:1px 10px;white-space:nowrap;&quot;&gt;&lt;span style=&quot;font-family: Consolas, monospace; font-size: 12px; color: rgb(51, 68, 82); font-weight: normal;&quot;&gt;linked_at&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;padding:1px 8px;text-align:right;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
