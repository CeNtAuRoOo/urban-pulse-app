root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Java
[*.java]
indent_size = 4


# Maven / XML
[*.xml]
indent_size = 4


# Frontend
[*.{js,jsx,ts,tsx,html,css}]
indent_size = 2

# Configuración
[*.{json,jsonc,yml,yaml,webmanifest}]
indent_size = 2


# Dockerfiles
[Dockerfile*]
indent_size = 4


# Spring / variables de entorno
[*.{properties,env}]
indent_size = 4


# En Markdown, dos espacios al final pueden tener significado
[*.md]
trim_trailing_whitespace = false
